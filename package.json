{
  "name": "excel-tool-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -n \"server,web\" -c \"cyan,magenta\" \"tsx watch apps/server/src/index.ts\" \"pnpm --filter @excel-harness/web dev\"",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "pnpm --filter @excel-harness/web dev",
    "build": "tsc --noEmit",
    "web:build": "pnpm --filter @excel-harness/web build",
    "test": "node --test",
    "eval": "tsx scripts/eval_agent.ts",
    "eval:gold": "python3 evals/run_eval.py --gold"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^10.0.5",
    "cordis": "^3.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
