{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@excel-harness/llm": ["packages/llm/src/index.ts"],
      "@excel-harness/session": ["packages/session/src/index.ts"],
      "@excel-harness/tools": ["packages/tools/src/index.ts"],
      "@excel-harness/agent-loop": ["packages/agent-loop/src/index.ts"],
      "@excel-harness/web-host": ["packages/web-host/src/index.ts"],
      "@excel-harness/excel-tool": ["packages/excel-tool/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "apps/web", "**/*.spec.ts"]
}
